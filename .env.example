# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# LLM Configuration
# Active Provider: "ollama", "anthropic", or "openai"
LLM_PROVIDER=ollama

# Ollama Local Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic Cloud Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Cloud Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# RAG Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.35

# Application Settings
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
